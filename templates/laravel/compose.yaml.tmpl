x-app-base: &app-base
  build:
    context: ..
    dockerfile: .slate/Dockerfile
    target: app
    args:
      APP_UID: ${APP_UID:-1000}
      APP_GID: ${APP_GID:-1000}
  entrypoint: ["sh", "/usr/local/bin/entrypoint"]
  command: ["apache2-foreground"]
  # Overrides reach app/queue as process env too, so they apply even when the
  # entrypoint leaves a worktree's own tracked .env in place.
  env_file:
    - ../.env.container
  environment:
    COMPOSER_HOME: /app/.slate/composer
  volumes:
    - ..:/app
{{- if .HasMainEnv}}
    - ${MAIN_ROOT:?Run via slate}/.env:/run/main-env/.env:ro
{{- end}}
    - ${MAIN_ROOT}/.git:${MAIN_ROOT}/.git:ro
    - ${SLATE_ENTRYPOINT:?Run via slate}:/usr/local/bin/entrypoint:ro
  depends_on:
    mysql:
      condition: service_healthy
    mailpit:
      condition: service_started

services:
  app:
    <<: *app-base
    ports:
      - "8080"

  queue:
    <<: *app-base
    command: ["php", "artisan", "queue:work", "--tries=3", "--timeout=60"]
    restart: unless-stopped
{{- if .Agent}}

  agent:
    <<: *app-base
    build:
      context: ..
      dockerfile: .slate/Dockerfile
      target: agent
      args:
        APP_UID: ${APP_UID:-1000}
        APP_GID: ${APP_GID:-1000}
    command: ["sleep", "infinity"]
    restart: unless-stopped
    environment:
      COMPOSER_HOME: /app/.slate/composer
      NPM_CONFIG_CACHE: /app/.slate/npm-cache
{{- end}}

  mysql:
    image: mysql:8.4
    environment:
      MYSQL_ROOT_PASSWORD: ${DB_PASSWORD:-secret}
      MYSQL_DATABASE: ${DB_DATABASE:-app}
    volumes:
      - mysql_data:/var/lib/mysql
    ports:
      - "3306"
    healthcheck:
      test: ["CMD", "mysqladmin", "ping", "-h", "localhost", "-uroot", "-p${DB_PASSWORD:-secret}"]
      interval: 5s
      timeout: 3s
      retries: 20

  vite:
    image: node:22
    working_dir: /app
    user: "${APP_UID:-1000}:${APP_GID:-1000}"
    env_file:
      - ../.env.container
    environment:
      NPM_CONFIG_CACHE: /app/.slate/npm-cache
    entrypoint: ["sh", "/usr/local/bin/entrypoint"]
    command: ["sh", "-c", "npm install && exec npm run dev -- --host 0.0.0.0"]
    ports:
      - "5173"
    volumes:
      - ..:/app
{{- if .HasMainEnv}}
      - ${MAIN_ROOT:?Run via slate}/.env:/run/main-env/.env:ro
{{- end}}
      - ${MAIN_ROOT}/.git:${MAIN_ROOT}/.git:ro
      - ${SLATE_ENTRYPOINT:?Run via slate}:/usr/local/bin/entrypoint:ro

  mailpit:
    image: axllent/mailpit:latest
    ports:
      - "8025"
      - "1025"

volumes:
  mysql_data:
